DATABASE_URL=postgres://pithosys:pithosys@localhost:5432/pithosys
TEST_DATABASE_URL=postgres://pithosys:pithosys@localhost:5432/pithosys_test
TEST_DATABASE_SCHEMA=pithosys_test
HTTP_ADDR=:8080
LOG_LEVEL=info

# Auth
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=
SESSION_SECRET_BASE64=
SESSION_TTL=168h
WEB_APP_URL=http://localhost:5173

# Optional OIDC (all three required together)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY_ID=local-dev
ENCRYPTION_KEY_BASE64=

# Worker and job runtime settings (poll intervals, schedulers, etc.)
# are stored in the database and managed via Settings → Worker / Jobs in the UI.
