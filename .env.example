DATABASE_URL=postgres://relic:relic@localhost:5432/relic
TEST_DATABASE_URL=postgres://relic:relic@localhost:5432/relic_test
TEST_DATABASE_SCHEMA=relic_test
HTTP_ADDR=:8080
AUTH_ENABLED=false
LOG_LEVEL=info

# Worker
WORKER_POLL_INTERVAL=2s
SCAN_SCHEDULER_ENABLED=true
# How often the worker checks whether buckets are due for scan. Defaults to WORKER_POLL_INTERVAL.
SCAN_SCHEDULER_INTERVAL=15s
# Fallback per-bucket interval when relic_config.scan.interval is unset.
SCAN_DEFAULT_INTERVAL=24h
# Delay between enqueueing scans when multiple buckets are due in one tick.
SCAN_STAGGER=30s

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY_ID=local-dev
ENCRYPTION_KEY_BASE64=
